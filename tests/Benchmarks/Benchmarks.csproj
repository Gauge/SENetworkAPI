<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Allocation and throughput harness for the hot paths.

        dotnet run -c Release  project tests/Benchmarks

    It runs against the SEStubs harness, not the game, so absolute numbers are
    indicative only. What matters is the delta between two runs: the stub
    serializer is the same protobuf-net the game uses, and the allocation
    counts come from the same code paths a real session would execute.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../*.cs" LinkBase="Production" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SEStubs/SEStubs.csproj" />
  </ItemGroup>

</Project>
