<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SEStubs</AssemblyName>
    <RootNamespace>SEStubs</RootNamespace>
    <!-- The stubs deliberately mirror the (untyped, pre-nullable) shape of the real
         Space Engineers ModAPI, so silence the noise that comes with that. -->
    <NoWarn>$(NoWarn);CS0067;CS0649</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.2.30" />
  </ItemGroup>

</Project>
